{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": [
      "vitest/globals"
    ],
    "noEmit": true,
    "jsx": "preserve",
    "preserveSymlinks": true
  },
  "include": [
    "src/env.d.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "test/**/*.ts"
  ],
  "exclude": [
    "dist"
  ]
}
