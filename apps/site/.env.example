# Public (build-time, inlined) configuration of the interactive islands
# (change: add-site-account-pages). Nothing here is a secret.

# Backend HTTP origin: web-auth cookie surface + /web/plans/* routes.
PUBLIC_API_URL=https://api.cymbra.app

# Google Web OAuth client id (same value as the back office / CYMBRA_GOOGLE_AUDIENCE).
# The site origin must be an Authorized JavaScript origin of that client. Unset = no
# Google button.
PUBLIC_GOOGLE_CLIENT_ID=

# Sign in with Apple Services ID (same as the back office); the site domain and the
# Return URLs /redeem and /account must be registered on it. Unset = no Apple button.
PUBLIC_APPLE_CLIENT_ID=

# Paddle.js: environment + client-side token (public), for /checkout.
PUBLIC_PADDLE_ENV=sandbox
PUBLIC_PADDLE_CLIENT_TOKEN=
