# Public (build-time, inlined) configuration of the interactive islands
# (change: add-site-account-pages). Nothing here is a secret.

# Backend HTTP origin: web-auth cookie surface + /web/plans/* routes.
PUBLIC_API_URL=https://api.cymbra.app

# Google Web OAuth client id (same value as the back office / CYMBRA_GOOGLE_AUDIENCE).
# The site origin must be an Authorized JavaScript origin of that client. Unset = no
# Google button.
PUBLIC_GOOGLE_CLIENT_ID=

# Sign in with Apple Services ID (same as the back office); the site domain and every
# Return URL must be registered on it: /redeem, /account, /suppression-compte,
# /delete-account and /eliminar-cuenta — the sign-in's page without its locale prefix
# (`appleReturnUrl` in src/lib/plan-view.ts). Unset = no Apple button.
PUBLIC_APPLE_CLIENT_ID=

# Paddle.js: environment + client-side token (public), for /checkout.
PUBLIC_PADDLE_ENV=sandbox
PUBLIC_PADDLE_CLIENT_TOKEN=

# Community invite (Discord), a permanent invite link. Surfaced as the "join the
# community" link on /lingua. Unset = the link is not rendered at all. In CI it comes
# from the repository variable of the same name (site-deploy.yml).
PUBLIC_DISCORD_URL=
