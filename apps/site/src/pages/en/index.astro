---
import Base from '../../layouts/Base.astro';
---

<Base title="Cymbra — connected music practice & lessons" lang="en">
  <section class="hero container">
    <h1>Learn music, <span class="gradient">connected to your instrument</span></h1>
    <p class="tagline">
      Cymbra turns practice into a guided experience: follow lessons, play along in
      real time with your instrument, and progress step by step.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary disabled" href="#">Coming soon to the App Store</a>
      <a class="btn btn-ghost disabled" href="#">Coming soon to Google Play</a>
    </div>
  </section>

  <section id="features" class="features container">
    <div class="card">
      <h3>🎹 Connected to your instruments</h3>
      <p>Plug in your MIDI keyboard or instrument and play along with the app in real time.</p>
    </div>
    <div class="card">
      <h3>📚 Guided lessons</h3>
      <p>Progressive lessons to learn at your own pace, from beginner to advanced.</p>
    </div>
    <div class="card">
      <h3>🎯 Real-time feedback</h3>
      <p>Follow the score, see your notes, and improve with immediate feedback.</p>
    </div>
    <div class="card">
      <h3>🔒 Privacy-first</h3>
      <p>Data hosted in France (EU), never sold, no advertising trackers.</p>
    </div>
  </section>
</Base>
