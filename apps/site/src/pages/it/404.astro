---
import Base from '../../layouts/Base.astro';
import { linguaHref } from '../../lib/lingua-pairs';

// See the French counterpart: without a 404 page the host serves the home page with
// a 200 for any unmatched path (change: pin-music-site-url-contract). Copied to
// `dist/it/404.html` by `localised404()` so an unmatched `/it/…` answers in Italian,
// not in French (change: add-site-italian-locale). « Home » and « Cymbra Music » open the
// Italian home and Music pages; Lingua's Italian page exists once a pair glossed in Italian
// ships (`linguaHref`), the English one until then. The account stays English.
---

<Base title="Pagina non trovata — Cymbra" lang="it" noindex alternates={{ fr: '/404', en: '/en/404', es: '/es/404', it: '/it/404' }}>
  <section class="hero container">
    <p class="kicker">Errore 404</p>
    <h1>Questa pagina <span class="gradient">non esiste</span></h1>
    <p class="tagline">
      Forse il link è scaduto, o nell'indirizzo c'è un errore di battitura.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/it/">Home</a>
      <a class="btn btn-ghost" href="/it/music">Cymbra Music</a>
      <a class="btn btn-ghost" href={linguaHref('it')}>Cymbra Lingua</a>
    </div>
    <p class="muted small hero-note">
      Cercavi altro? <a href="/it/assistenza">L'assistenza</a>, <a href="/en/account">il tuo account</a>, <a href="/it/privacy">la privacy</a> o <a href="/it/termini">i termini di utilizzo</a>.
    </p>
  </section>
</Base>
