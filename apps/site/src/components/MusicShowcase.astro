---
// Cymbra Music, shown (change: add-site-music-showcase): the showcase video and the
// gallery of store captures, in the page's language. The media are copies of what the
// Music capture harness generated (`src/lib/music-media.ts`); this component only lays
// them out.
//
// The video starts silent and only plays once on screen — browsers refuse sound without
// a gesture, and `preload="none"` keeps it off the first render. A visitor who asked to
// reduce motion gets the poster and the player's controls instead. The sound button
// unmutes and restarts it, so the piece is heard from its first note.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../lib/i18n';
import { GALLERY, GALLERY_HEADING, POSTER_FILE, VIDEO_COPY, VIDEO_FILE } from '../lib/music-media';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props as Props;

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/music/*/*.{png,jpg}', { eager: true });
const videos = import.meta.glob<string>('../assets/music/*/*.mp4', { eager: true, query: '?url', import: 'default' });

function image(file: string): ImageMetadata {
  const found = images[`../assets/music/${lang}/${file}`];
  if (!found) throw new Error(`MusicShowcase: ${lang}/${file} is missing — run \`yarn sync:music-media\``);
  return found.default;
}
const video = videos[`../assets/music/${lang}/${VIDEO_FILE}`];
if (!video) throw new Error(`MusicShowcase: ${lang}/${VIDEO_FILE} is missing — run \`yarn sync:music-media\``);
const poster = image(POSTER_FILE);
const copy = VIDEO_COPY[lang];
---

<section class="showcase container" aria-labelledby="showcase-video-heading">
  <h2 id="showcase-video-heading">{copy.heading}</h2>
  <p class="muted">{copy.text}</p>
  <figure class="showcase-video" data-showcase-video>
    <video
      muted
      loop
      playsinline
      preload="none"
      poster={poster.src}
      width={poster.width}
      height={poster.height}
      aria-label={copy.label}
    >
      <source src={video} type="video/mp4" />
    </video>
    <button type="button" class="btn btn-ghost showcase-sound" data-listen={copy.listen} data-mute={copy.mute}>
      {copy.listen}
    </button>
  </figure>

  <h2>{GALLERY_HEADING[lang]}</h2>
  <div class="showcase-gallery">
    {GALLERY.map((shot, i) => (
      <figure>
        <Picture
          src={image(shot.file)}
          alt={shot.alt[lang]}
          formats={['avif', 'webp']}
          fallbackFormat="png"
          widths={[480, 960, 1600]}
          sizes={i === 0 ? '(min-width: 900px) 860px, 100vw' : '(min-width: 900px) 420px, 100vw'}
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
        />
        <figcaption>{shot.caption[lang]}</figcaption>
      </figure>
    ))}
  </div>
</section>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const figure of document.querySelectorAll<HTMLElement>('[data-showcase-video]')) {
    const video = figure.querySelector('video');
    const button = figure.querySelector<HTMLButtonElement>('button');
    if (!video || !button) continue;
    if (reduceMotion) {
      video.controls = true;
    } else {
      new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) video.play().catch(() => (video.controls = true));
          else video.pause();
        }
      }, { threshold: 0.4 }).observe(video);
    }
    button.addEventListener('click', () => {
      if (video.muted) {
        video.muted = false;
        video.currentTime = 0;
        void video.play();
        button.textContent = button.dataset.mute ?? '';
      } else {
        video.muted = true;
        button.textContent = button.dataset.listen ?? '';
      }
    });
  }
</script>

<style>
  .showcase { padding-block: 2rem 1rem; }
  .showcase h2 { margin: 2rem 0 0.5rem; }
  .showcase-video { position: relative; margin: 1.25rem 0 0; }
  .showcase-video video,
  .showcase-gallery :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .showcase-sound { position: absolute; right: 0.75rem; bottom: 0.75rem; background: rgba(13, 15, 20, 0.8); }
  .showcase-gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-top: 1.25rem; }
  .showcase-gallery figure { margin: 0; }
  .showcase-gallery figure:first-child { grid-column: 1 / -1; }
  .showcase-gallery figcaption { color: var(--muted); font-size: 0.95rem; margin-top: 0.5rem; text-align: center; }
</style>
