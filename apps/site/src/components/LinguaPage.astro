---
// The Lingua page in any site language, built from the shipped pairs (change:
// add-site-lingua-matrix-pages, D1): the data from `src/lib/lingua-pairs.ts`, the words
// from the table beside it, `src/lib/lingua-text.ts` — one per language, the French one
// today's page byte for byte. `src/pages/lingua.astro`, `en/lingua.astro` and
// `[locale]/lingua.astro` are one line each around this.
//
// Every text slot is inserted with `set:html`, never as an `{expression}`: an expression
// escapes apostrophes (`'` → `&#39;`) and would move the French bytes (D1). The strings
// are the site's own; what comes from the data files is checked by `lingua-pairs.ts` and
// escaped by `lingua-text.ts`'s `fill`. A test renders this page on its own pair list by
// standing in for the data files (`test/astro/lingua-page.spec.ts`), so the layout's
// Spanish links read the same list.
//
// The coverage table has two layouts (change: add-lingua-french-listings, D8): while every
// pair is glossed in one language, one column per pair — today's markup, untouched; once in
// two, one row per pair, the pair its row's header, inside a box that scrolls on its own
// (`.table-scroll`, `global.css`) so that a phone's page never scrolls sideways.
import Base from '../layouts/Base.astro';
import Community from './Community.astro';
import StoreButtons from './StoreButtons.astro';
import { linguaStores } from '../lib/stores';
import { config } from '../lib/config';
import type { Lang } from '../lib/i18n';
import { linguaAlternates, shippedPairs } from '../lib/lingua-pairs';
import { linguaPageText } from '../lib/lingua-text';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const shipped = shippedPairs();
const t = linguaPageText(lang, shipped, { discordUrl: config.discordUrl });
---

<Base title={t.title} description={t.description} lang={lang} alternates={linguaAlternates(shipped.pairs)}>
  <section class="hero container">
    <p class="kicker" set:html={t.kicker} />
    <h1 set:html={t.headline} />
    <p class="tagline" set:html={t.tagline} />
    <StoreButtons links={linguaStores(lang)} />
    <p class="muted small hero-note" set:html={t.heroNote} />
  </section>

  <section id={t.featuresId} class="features container">
    {t.cards.map((card) => (
      <div class="card">
        <h3 set:html={card.title} />
        <p set:html={card.body} />
      </div>
    ))}
  </section>

  <section id="couverture" class="container prose coverage">
    <h2 set:html={t.coverage.heading} />
    <p set:html={t.coverage.caption} />
    {t.coverage.perPair ? (
      <div class="table-scroll">
        <table>
          <thead>
            <tr>{t.coverage.head.map((cell) => <th set:html={cell} />)}</tr>
          </thead>
          <tbody>
            {t.coverage.rows.map(([pair, ...cells]) => (
              <tr>
                <th scope="row" set:html={pair} />
                {cells.map((cell) => <td set:html={cell} />)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <table>
        <thead>
          <tr>{t.coverage.head.map((cell) => <th set:html={cell} />)}</tr>
        </thead>
        <tbody>
          {t.coverage.rows.map((row) => (
            <tr>{row.map((cell) => <td set:html={cell} />)}</tr>
          ))}
        </tbody>
      </table>
    )}
    <p class="muted small" set:html={t.coverage.note} />
  </section>

  <Community lang={lang} />

  <section class="container closing">
    <h2 set:html={t.closing.heading} />
    <p class="muted" set:html={t.closing.body} />
  </section>
</Base>
