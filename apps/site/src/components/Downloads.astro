---
// App download links per platform (design open question → yes): a useful landing
// after a web purchase. The links themselves live in `src/lib/stores.ts`, shared
// with the home hub and the product pages.
import StoreButtons from './StoreButtons.astro';
import { musicStores } from '../lib/stores';
import type { Lang } from '../lib/i18n';

const { lang = 'fr' } = Astro.props as { lang?: Lang };
const TITLE: Record<Lang, string> = {
  fr: 'Télécharger Cymbra Music',
  en: 'Get Cymbra Music',
  es: 'Descargar Cymbra Music',
};
---

<section class="downloads">
  <h3>{TITLE[lang]}</h3>
  <StoreButtons links={musicStores(lang)} centered={false} />
</section>
