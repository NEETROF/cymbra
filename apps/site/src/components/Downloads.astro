---
// App download links per platform (design open question → yes): a useful landing
// after a web purchase. The links themselves live in `src/lib/stores.ts`, shared
// with the home hub and the product pages; the desktop builds (Windows Store, Linux
// AppImage) are the Music page's island (change: add-music-download-page).
import StoreButtons from './StoreButtons.astro';
import MusicDownloadsIsland from './MusicDownloadsIsland.vue';
import { musicAppStores } from '../lib/stores';
import { config } from '../lib/config';
import type { Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'fr' } = Astro.props;
const TITLE: Record<Lang, string> = {
  fr: 'Télécharger Cymbra Music',
  en: 'Get Cymbra Music',
  es: 'Descargar Cymbra Music',
};
---

<section class="downloads">
  <h3>{TITLE[lang]}</h3>
  <StoreButtons links={musicAppStores()} centered={false} />
  <MusicDownloadsIsland client:load lang={lang} storeProductId={config.msStoreProductId} />
</section>
