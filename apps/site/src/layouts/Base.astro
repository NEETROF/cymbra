---
import '../styles/global.css';
import { config } from '../lib/config';
import { LANGS, type Lang } from '../lib/i18n';
import { linguaHref } from '../lib/lingua-pairs';

/** The page's address in each language it exists in. */
type Alternates = Partial<Record<Lang, string>>;

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  /** Account / redeem / checkout pages are personal surfaces, not landing content. */
  noindex?: boolean;
  /**
   * The page's address in each language it exists in, its own included. The twins are
   * NOT derivable from the path (`/confidentialite` ↔ `/en/privacy` ↔ `/es/privacidad`),
   * so each page declares them (change: add-site-spanish-locale): they drive the
   * header's language switch — every OTHER language the page exists in — and
   * `hreflang`, one per alternate. A page that exists in one language passes that one
   * alone: no switch, its own `hreflang`.
   */
  alternates: Alternates;
}

const {
  title,
  description = 'Cymbra — des apps qui apprennent avec vous : la musique connectée à votre instrument, le vocabulaire connecté à ce que vous lisez.',
  lang = 'fr',
  noindex = false,
  alternates,
} = Astro.props;

// A page that omits its own language from `alternates` would ship no `hreflang` for
// itself and a switch that cannot come back: refuse it at build time.
if (!alternates[lang]) {
  throw new Error(`${title}: \`alternates\` must name the page's own language (${lang}) — got ${JSON.stringify(alternates)}`);
}

interface Link {
  href: string;
  label: string;
}

// One table per language: the brand's home, the header nav and the footer (the
// community link slots between `footerHead` and `footerTail` when an invite is set).
// The Spanish table links the Spanish pages — the home and Music's page included
// (change: extend-site-spanish-locale) — and, where a page has no Spanish twin
// (account, code), its English page. Lingua's Spanish page exists once a pair glossed
// in Spanish ships (`linguaHref`, change: add-site-lingua-matrix-pages): the English
// one until then.
const TABLES: Record<Lang, { home: string; nav: Link[]; footerHead: Link[]; footerTail: Link[] }> = {
  fr: {
    home: '/',
    nav: [
      { href: '/music', label: 'Music' },
      { href: '/lingua', label: 'Lingua' },
      { href: '/confidentialite', label: 'Confidentialité' },
      { href: '/cgu', label: 'CGU' },
      { href: '/account', label: 'Mon compte' },
    ],
    footerHead: [
      { href: '/music', label: 'Music' },
      { href: '/lingua', label: 'Lingua' },
      { href: '/support', label: 'Aide' },
    ],
    footerTail: [
      { href: '/confidentialite', label: 'Confidentialité' },
      { href: '/cgu', label: 'CGU' },
      { href: '/account', label: 'Mon compte' },
      { href: '/redeem', label: "Code d'accès" },
      { href: '/suppression-compte', label: 'Supprimer mon compte' },
      { href: '/en/', label: 'EN' },
    ],
  },
  en: {
    home: '/en/',
    nav: [
      { href: '/en/music', label: 'Music' },
      { href: '/en/lingua', label: 'Lingua' },
      { href: '/en/privacy', label: 'Privacy' },
      { href: '/en/terms', label: 'Terms' },
      { href: '/en/account', label: 'Account' },
    ],
    footerHead: [
      { href: '/en/music', label: 'Music' },
      { href: '/en/lingua', label: 'Lingua' },
      { href: '/en/support', label: 'Support' },
    ],
    footerTail: [
      { href: '/en/privacy', label: 'Privacy' },
      { href: '/en/terms', label: 'Terms' },
      { href: '/en/account', label: 'Account' },
      { href: '/en/redeem', label: 'Access code' },
      { href: '/en/delete-account', label: 'Delete my account' },
      { href: '/', label: 'FR' },
    ],
  },
  es: {
    home: '/es/',
    nav: [
      { href: '/es/music', label: 'Music' },
      { href: linguaHref('es'), label: 'Lingua' },
      { href: '/es/privacidad', label: 'Privacidad' },
      { href: '/es/terminos', label: 'Términos' },
      { href: '/en/account', label: 'Cuenta' },
    ],
    footerHead: [
      { href: '/es/music', label: 'Music' },
      { href: linguaHref('es'), label: 'Lingua' },
      { href: '/es/soporte', label: 'Ayuda' },
    ],
    footerTail: [
      { href: '/es/privacidad', label: 'Privacidad' },
      { href: '/es/terminos', label: 'Términos' },
      { href: '/en/account', label: 'Cuenta' },
      { href: '/en/redeem', label: 'Código de acceso' },
      { href: '/es/eliminar-cuenta', label: 'Eliminar mi cuenta' },
      { href: '/', label: 'FR' },
      { href: '/en/', label: 'EN' },
    ],
  },
};
const { home, nav, footerHead, footerTail } = TABLES[lang];

// The alternates in `LANGS`' order, for `hreflang` (each of them) and the switch (the
// others). No `x-default`: the site has none today, and choosing one is the owner's.
const LABEL: Record<Lang, string> = { fr: 'FR', en: 'EN', es: 'ES' };
const hreflangs: { lang: Lang; href: string }[] = [];
for (const l of LANGS) {
  const href = alternates[l];
  if (href) hreflangs.push({ lang: l, href });
}
const otherLocales: Link[] = hreflangs.filter((a) => a.lang !== lang).map((a) => ({ href: a.href, label: LABEL[a.lang] }));
const site = 'https://cymbra.app';
// The community server, on every page — header and footer — when an invite is set.
const discordUrl = config.discordUrl;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" sizes="48x48" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {hreflangs.map((a) => <link rel="alternate" hreflang={a.lang} href={`${site}${a.href}`} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={home}>Cymbra</a>
        {/* Phones collapse the nav into the burger: the community button stays in
            the bar itself, outside the panel, so it is visible without a tap. */}
        {discordUrl && <a class="header-discord" href={discordUrl} rel="noopener">Discord</a>}
        {/* The mobile menu is CSS-only — the layout ships no JS. A focusable
            checkbox drives the panel and the label is the visual target; every
            entry is a full page load, so navigating closes the menu for free. */}
        <input class="nav-toggle" type="checkbox" id="nav-toggle" aria-label="Menu" />
        <label class="nav-burger" for="nav-toggle" aria-hidden="true">
          <span></span><span></span><span></span>
        </label>
        <nav class="nav-links">
          {nav.map((l) => <a href={l.href}>{l.label}</a>)}
          {discordUrl && <a class="nav-discord" href={discordUrl} rel="noopener">Discord</a>}
          {otherLocales.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>© {new Date().getFullYear()} NEETROF — Cymbra</span>
        <nav>
          {/* Astro escapes the apostrophe of « Code d'accès » (`&#39;`), which the
              literal markup never did: same rendering, one byte-level difference. */}
          {footerHead.map((l) => <a href={l.href}>{l.label}</a>)}
          {discordUrl && <a href={discordUrl} rel="noopener">Discord</a>}
          {footerTail.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      </div>
    </footer>
  </body>
</html>
