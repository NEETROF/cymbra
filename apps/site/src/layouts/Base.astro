---
import '../styles/global.css';

const {
  title,
  description = 'Cymbra — des apps qui apprennent avec vous : la musique connectée à votre instrument, le vocabulaire connecté à ce que vous lisez.',
  lang = 'fr',
  // Account / redeem / checkout pages are personal surfaces, not landing content.
  noindex = false,
  // The same page in the other locale. The pair is NOT derivable from the path
  // (`/confidentialite` ↔ `/en/privacy`), so each page that has a counterpart
  // declares it: it drives both the header's language switch and `hreflang`.
  frHref = '/',
  enHref = '/en/',
} = Astro.props;

const isFr = lang === 'fr';
const nav = isFr
  ? [
      { href: '/music', label: 'Music' },
      { href: '/lingua', label: 'Lingua' },
      { href: '/confidentialite', label: 'Confidentialité' },
      { href: '/cgu', label: 'CGU' },
      { href: '/account', label: 'Mon compte' },
    ]
  : [
      { href: '/en/music', label: 'Music' },
      { href: '/en/lingua', label: 'Lingua' },
      { href: '/en/privacy', label: 'Privacy' },
      { href: '/en/terms', label: 'Terms' },
      { href: '/en/account', label: 'Account' },
    ];
const otherLocale = isFr ? { href: enHref, label: 'EN' } : { href: frHref, label: 'FR' };
const home = isFr ? '/' : '/en/';
const site = 'https://cymbra.app';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" sizes="48x48" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="alternate" hreflang="fr" href={`${site}${frHref}`} />
    <link rel="alternate" hreflang="en" href={`${site}${enHref}`} />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={home}>Cymbra</a>
        <nav class="nav-links">
          {nav.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href={otherLocale.href}>{otherLocale.label}</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>© {new Date().getFullYear()} NEETROF — Cymbra</span>
        <nav>
          {isFr ? (
            <>
              <a href="/music">Music</a>
              <a href="/lingua">Lingua</a>
              <a href="/support">Aide</a>
              <a href="/confidentialite">Confidentialité</a>
              <a href="/cgu">CGU</a>
              <a href="/account">Mon compte</a>
              <a href="/redeem">Code d'accès</a>
              <a href="/suppression-compte">Supprimer mon compte</a>
              <a href="/en/">EN</a>
            </>
          ) : (
            <>
              <a href="/en/music">Music</a>
              <a href="/en/lingua">Lingua</a>
              <a href="/en/support">Support</a>
              <a href="/en/privacy">Privacy</a>
              <a href="/en/terms">Terms</a>
              <a href="/en/account">Account</a>
              <a href="/en/redeem">Access code</a>
              <a href="/en/delete-account">Delete my account</a>
              <a href="/">FR</a>
            </>
          )}
        </nav>
      </div>
    </footer>
  </body>
</html>
