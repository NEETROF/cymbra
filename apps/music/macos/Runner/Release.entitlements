<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs environment for push notifications (change: add-push-notifications). -->
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- flutter_secure_storage needs an explicit access group to reach the keychain
	     under App Sandbox; without it a signed sandboxed build loses its session
	     token on every launch. Must stay identical in DebugProfile.entitlements —
	     the asymmetry is how this went unnoticed (the CI artifact was unsigned, so
	     the sandbox was never really exercised).

	     Deliberately NOT here: com.apple.security.network.server. macOS sign-in uses
	     the native Google SDK / Sign in with Apple, not the loopback listener that
	     Windows and Linux need (lib/services/oidc_token_source.dart). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.cymbra.music</string>
	</array>
</dict>
</plist>
