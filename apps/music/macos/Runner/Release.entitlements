<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs environment for push notifications (change: add-push-notifications).
	     macOS spells this key with the `com.apple.developer.` prefix, unlike iOS
	     - see DebugProfile.entitlements for why that matters. -->
	<key>com.apple.developer.aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Required by the native Google Sign-In flow on macOS (GoogleSignIn / AppAuth
	     under App Sandbox): without it "Continue with Google" fails silently in a
	     signed sandboxed build ("Something went wrong", no auth window) while the
	     dev build — which carries it in DebugProfile.entitlements — works. Verified
	     by differential test on the release build (2026-08-17). -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- Acoustic piano input (change: add-acoustic-piano-input): microphone
	     capture under App Sandbox. Keep IDENTICAL in both entitlement files —
	     and re-verify on the store archive export, which has previously
	     re-signed with stripped entitlements (see memory: macOS App Store
	     publishing). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- flutter_secure_storage needs an explicit access group to reach the keychain
	     under App Sandbox; without it a signed sandboxed build loses its session
	     token on every launch. Must stay identical in DebugProfile.entitlements —
	     the asymmetry is how this went unnoticed (the CI artifact was unsigned, so
	     the sandbox was never really exercised). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.cymbra.music</string>
	</array>
</dict>
</plist>
