<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store export. Unlike iOS there is no `flutter build ... --export-
	     options-plist` for macOS: `flutter build macos` stops at the .app, so this
	     file is consumed by an explicit xcodebuild pass. See apps/music/README.md
	     ("macOS signing") for the three-command sequence.

	     `app-store-connect` makes -exportArchive emit a .pkg — a submission
	     artifact, not something a user can double-click to install. (Xcode 15.3
	     renamed the method from `app-store`, which now warns as deprecated.) -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>VMFJ6KRW77</string>
	<!-- Manual signing, same as the CI export. Automatic signing does NOT work
	     here: it makes xcodebuild ask the Apple account for a matching profile,
	     which it cannot do unauthenticated from the command line, and the export
	     dies with "No profiles for 'com.cymbra.music' were found" even though the
	     right profile is installed locally. Naming the profile explicitly also
	     means a local export and a CI export sign identically. -->
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.cymbra.music</key>
		<string>Cymbra Music macOS App Store</string>
	</dict>
	<!-- The package itself is signed by a *different* identity than the app: Mac
	     Installer Distribution, not Apple Distribution. -->
	<key>installerSigningCertificate</key>
	<string>3rd Party Mac Developer Installer</string>
	<key>uploadSymbols</key>
	<true/>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
