  "notationBeatUnitHalf": "minima",
  "notationBeatUnitQuarter": "semiminima (♩)",
  "notationBeatUnitEighth": "croma (♪)",
  "notationBeatUnitSixteenth": "semicroma",
  "notationBeatUnitOther": "quella figura",
  "notationHelpNoteDuration": "Qui {name}: {beats}.",
  "notationHelpGraceTitle": "Abbellimento ({name})",
  "notationHelpGraceBody": "Una piccola nota ornamentale suonata molto in fretta, subito prima della nota che decora. Non occupa tempo proprio: sfiorala e passa alla nota successiva.",
  "notationHelpRepeatStartTitle": "Ritornello — inizio",
  "notationHelpRepeatStartBody": "La sezione tra i segni di ritornello si suona un'altra volta. Questo segno indica dove inizia il passaggio ripetuto.",
  "notationHelpRepeatEndTitle": "Ritornello — fine",
  "notationHelpRepeatEndBody": "Torna al segno d'inizio (o all'inizio del brano) e risuona la sezione. Con le parentesi numerate sopra il pentagramma, ogni passaggio prende il proprio finale.",
  "notationHelpVoltaTitle": "Casella {label}",
  "notationHelpVoltaBody": "Un finale numerato: queste battute si suonano solo al passaggio indicato — casella 1 la prima volta, casella 2 la seconda.",
  "notationHelpMeasureRepeatTitle": "Ripeti la battuta precedente",
  "notationHelpMeasureRepeatBody": "Il segno % significa: suona di nuovo la battuta precedente, nota per nota.",
  "notationHelpSegnoTitle": "Segno",
  "notationHelpSegnoBody": "Un segno di rimando. Quando lo spartito indica D.S. (dal segno), riprendi da questo segno.",
  "notationHelpCodaTitle": "Coda",
  "notationHelpCodaBody": "La sezione conclusiva. Un'indicazione «al Coda» salta dalla metà del brano fino a questo segno.",
  "notationHelpJumpTitle": "{words}",
  "notationHelpJumpBody": "Un'indicazione di percorso: D.C. rimanda all'inizio, D.S. al segno; «al Fine» si suona fino alla parola Fine, «al Coda» salta alla coda.",
