<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Cymbra Music</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Cymbra Music</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Export-compliance: the app uses only standard TLS/HTTPS (an exempt
	     encryption category), so no non-exempt encryption. Declaring this here
	     skips the "Export Compliance" question on every TestFlight/App Store
	     upload. Revisit if proprietary/non-exempt crypto is ever added. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Landscape-only music-notation app. Opt out of iPad multitasking
	     (Split View / Slide Over) so a restricted, landscape-only orientation
	     set is allowed — otherwise App Store validation (error 90474) demands
	     all four orientations for iPad multitasking support. -->
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Managed by flutter_native_splash: keeps the status bar visible over the
	     branded launch screen. -->
	<key>UIStatusBarHidden</key>
	<false/>
	<!-- Local network access (iOS 14+): required in dev to reach a gRPC backend on
	     the LAN (e.g. --dart-define=CYMBRA_GRPC_HOST=<dev-machine-ip>). Harmless in
	     prod, which uses a real server domain. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Cymbra connects to your Cymbra ID server on the local network during development.</string>
	<!-- Purpose strings required by App Store static analysis (error 90683): a
	     transitive dependency references the Camera and Photo Library APIs, so
	     Apple requires a purpose string even though the app does not currently
	     use these APIs. Access is only requested if the user picks an image
	     (e.g. an avatar); the app functions fully without granting it. -->
	<!-- Acoustic piano input (change: add-acoustic-piano-input): the microphone
	     is opened only when the user selects the microphone input source or runs
	     the input calibration, and never outside those features. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Cymbra listens to your acoustic instrument through the microphone so it can follow the notes you play.</string>
	<key>NSCameraUsageDescription</key>
	<string>Cymbra can use the camera if you choose to take a photo, for example to set a profile picture.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Cymbra can access your photo library if you choose to select an image, for example to set a profile picture.</string>
	<!-- Location is never used by the app; GoogleUtilities (pulled in by
	     GoogleSignIn) weakly references CoreLocation, which trips App Store
	     static analysis (warning 90683). This string satisfies the check. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Cymbra does not use your location. This entry is required by a sign-in library included in the app.</string>
	<!-- Google Sign-In callback (add-music-account-access, task 6.3b). The reversed
	     client ID suffix is injected at build time via the GOOGLE_OAUTH_CLIENT_SUFFIX
	     build setting (see Flutter/Debug.xcconfig + Secrets.xcconfig), so the real
	     client ID is never committed. Unconfigured builds expand to an inert
	     placeholder, and the Google button stays hidden until GOOGLE_CLIENT_ID is
	     supplied via --dart-define. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.$(GOOGLE_OAUTH_CLIENT_SUFFIX)</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
