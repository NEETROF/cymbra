# Backend gRPC-web endpoint (tonic-web). The server's CYMBRA_BACK_OFFICE_ORIGINS
# must include this app's origin for the browser to reach it.
VITE_GRPC_WEB_URL=http://localhost:50051

# Google OIDC web client id for back-office sign-in (targets the `music` audience).
# Optional in dev — local email/password sign-in works without it.
# VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
