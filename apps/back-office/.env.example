# Backend gRPC-web endpoint (tonic-web). The server's CYMBRA_BACK_OFFICE_ORIGINS
# must include this app's origin for the browser to reach it.
VITE_GRPC_WEB_URL=http://localhost:50051

# Backend web-auth HTTP surface (cookie sign-in/refresh/logout). Lives on the HTTP
# server (the JWKS/health port), NOT the gRPC-web port. The refresh token rides in an
# HttpOnly cookie; the access token is returned in the body for in-memory use only.
# In prod this MUST be same-site with the SPA (e.g. api.cymbra.app + bo.cymbra.app
# under cymbra.app) so the cookie is first-party.
VITE_WEB_AUTH_URL=http://localhost:8081

# Google OIDC web client id for back-office sign-in (targets the `music` audience).
# Optional in dev — local email/password sign-in works without it.
# VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# SoundFont for the preview playback. Fetched at runtime (with the access token) from
# the backend delivery route `GET /soundfonts/{id}` (change: add-soundfont-delivery),
# NOT bundled. Defaults to `${VITE_WEB_AUTH_URL}/soundfonts/upright-piano-kw` (the route
# lives on the web-auth/API origin); set this to override the id or host.
# VITE_SOUNDFONT_URL=http://localhost:8081/soundfonts/upright-piano-kw
