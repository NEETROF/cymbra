# Dependencies (Yarn Berry, node-modules linker)
node_modules/
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
.pnp.*

# Build output (one dir per browser variant)
dist/
dist-chromium/
dist-firefox/
dist-safari/
# The capture tool's build and the store captures it writes (tool/capture/, add-site-lingua-showcase):
# never published, never committed — the owner uploads the captures by hand.
dist-capture/
store-captures/
# The Cymbra Lingua app's page (add-lingua-apple-review), bundled by apps/lingua-apple.
dist-app/
web-ext-artifacts/
coverage/

# Generated wasm bindings (produced by `yarn gen:wasm` from crates/lingua-wasm)
src/wasm/pkg/

# Generated gRPC-web/protobuf stubs (produced by `yarn gen:proto`, like the back office's)
src/gen/

# Shipped/dogfooding data packs (built by `yarn gen:pack`; real packs are never committed): each
# pair's layer under assets/packs/, each studied language's base under assets/bases/
# (ship-lingua-pack-bases-once D1). The tiny testdata pack and its parts under test/fixtures/ ARE
# committed as vitest fixtures.
assets/packs/
assets/bases/
# The single pack of builds before generalise-lingua-pack-build, still in older checkouts.
assets/pack.lingua

# The translation engine (`yarn fetch:engine` or `tool/build_engine.sh`): bergamot-translator.js
# and .wasm, checked against engine-pin.json by build.mjs. Never committed.
/engine/
