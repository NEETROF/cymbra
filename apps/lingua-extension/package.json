{
  "name": "@cymbra/lingua-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "yarn@4.10.3",
  "description": "Cymbra Lingua — MV3 browser extension (Chromium): reads the web in place, highlights unknown words, honest per-page percentage.",
  "scripts": {
    "gen:wasm": "bash tool/gen_wasm.sh",
    "gen:pack": "bash tool/gen_pack.sh assets/pack.lingua",
    "gen:pack:real": "bash ../../scripts/lingua-data/build.sh en-fr assets/pack.lingua",
    "gen:fixtures": "bash tool/gen_pack.sh test/fixtures/en-fr.testdata.lingua",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node build.mjs",
    "build:chromium": "node build.mjs chromium",
    "build:firefox": "node build.mjs firefox",
    "start:firefox": "web-ext run --source-dir dist-firefox",
    "start:firefox-android": "web-ext run --target firefox-android --source-dir dist-firefox"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.9",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.24.0",
    "eslint": "^10.8.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7",
    "web-ext": "^8.3.0"
  }
}
