# Cymbra backend — PRODUCTION env (single-box). Copy to `.env` on the server and
# fill EVERY value. Never commit the filled `.env`. Keep it `chmod 600`.
#
# IMPORTANT coupling: the CYMBRA_*_DB_PASSWORD values below are what db/init sets
# as the per-module role passwords on first Postgres init; they MUST match the
# passwords embedded in the corresponding *_DATABASE_URL. Change one → change both.

# --- Public domain (Caddy TLS + the URL the apps target) ---------------------
API_DOMAIN=api.example.com

# --- Backend image (GHCR) ----------------------------------------------------
CYMBRA_IMAGE=ghcr.io/neetrof/cymbra-backend:latest

# --- Postgres superuser + per-module role passwords --------------------------
# Generate each with:  openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_superuser
CYMBRA_AUTH_DB_PASSWORD=CHANGE_ME_auth
CYMBRA_USER_DB_PASSWORD=CHANGE_ME_user
CYMBRA_WORKER_DB_PASSWORD=CHANGE_ME_worker
CYMBRA_ADMIN_DB_PASSWORD=CHANGE_ME_admin

# --- Database URLs (host = the compose service name `postgres`) ---------------
# The password in each URL must equal the matching CYMBRA_*_DB_PASSWORD above.
CYMBRA_AUTH_DATABASE_URL=postgres://auth_svc:CHANGE_ME_auth@postgres:5432/cymbra
CYMBRA_USER_DATABASE_URL=postgres://user_svc:CHANGE_ME_user@postgres:5432/cymbra
CYMBRA_WORKER_DATABASE_URL=postgres://worker_svc:CHANGE_ME_worker@postgres:5432/cymbra
CYMBRA_ADMIN_DATABASE_URL=postgres://admin_svc:CHANGE_ME_admin@postgres:5432/cymbra

# --- Redis / Valkey (host = the compose service name `valkey`) ----------------
CYMBRA_REDIS_URL=redis://valkey:6379

# --- gRPC + HTTP listeners (inside the container; Caddy fronts them) ----------
CYMBRA_GRPC_ADDR=0.0.0.0:50051
CYMBRA_HTTP_ADDR=0.0.0.0:8081

# --- App audiences -----------------------------------------------------------
CYMBRA_ALLOWED_AUDIENCES=music,live

# --- Internal token signing (EdDSA Ed25519; public key served at JWKS) --------
# Generate once:
#   openssl genpkey -algorithm ed25519 -out priv.pem
#   openssl pkey -in priv.pem -pubout -out pub.pem
# Paste the PEM bodies here (multi-line PEM must be quoted or \n-escaped — see DEPLOY.md).
CYMBRA_TOKEN_SIGNING_KEY_PEM=
CYMBRA_TOKEN_PUBLIC_KEY_PEM=
CYMBRA_TOKEN_SIGNING_KID=k1
CYMBRA_ACCESS_TOKEN_TTL=15m
CYMBRA_REFRESH_TOKEN_TTL=30d

# --- OIDC providers (Google / Apple) -----------------------------------------
CYMBRA_GOOGLE_ISSUER=https://accounts.google.com
CYMBRA_GOOGLE_AUDIENCE=
CYMBRA_APPLE_ISSUER=https://appleid.apple.com
CYMBRA_APPLE_AUDIENCE=
# Below are UNUSED by the current native-id_token flow (the backend only verifies
# Apple's id_token against its JWKS). Fill them only if/when you add the web
# authorization-code exchange or Apple server-to-server token revocation.
CYMBRA_APPLE_P8_KEY_PEM=
CYMBRA_APPLE_TEAM_ID=
CYMBRA_APPLE_KEY_ID=

# --- Local credential hardening ----------------------------------------------
CYMBRA_PASSWORD_MIN_LENGTH=12
CYMBRA_SIGNIN_MAX_ATTEMPTS=5
CYMBRA_SIGNIN_LOCKOUT=15m
CYMBRA_EMAIL_SEND_RATE=3/1h

# --- SMTP (verification / reset email) — real transactional provider ----------
# Recommended: Brevo (EU-hosted, GDPR-friendly, free tier ~300 emails/day; SMTP
# relay works directly with lettre's STARTTLS on 587). Alternatives: Resend (EU
# region, free 3k/mo), Postmark (best deliverability, paid).
# Brevo example (login = your Brevo account email, pass = an SMTP *key*, not your
# password): smtp://you@example.com:xkeysib-...@smtp-relay.brevo.com:587
CYMBRA_SMTP_URL=smtp://SMTP_LOGIN:SMTP_KEY@smtp-relay.brevo.com:587
# FROM must be on a domain you control AND have SPF+DKIM set up for (see DEPLOY.md
# §Email deliverability), or verification mail lands in spam.
CYMBRA_SMTP_FROM=no-reply@example.com

# --- Background worker --------------------------------------------------------
# Also reads CYMBRA_AUTH_DATABASE_URL above (the session-reaper deletes expired
# auth.sessions) and CYMBRA_USER_DATABASE_URL (the orphan-reaper).
CYMBRA_WORKER_HTTP_ADDR=0.0.0.0:8082
CYMBRA_WORKER_CONCURRENCY_MIN=1
CYMBRA_WORKER_CONCURRENCY_MAX=16
CYMBRA_WORKER_SCHEDULER_INTERVAL=30s
CYMBRA_WORKER_DLQ_SWEEP_INTERVAL=60s
CYMBRA_ORPHAN_REAP_GRACE=24h

# --- OpenTelemetry -----------------------------------------------------------
# OFF by default (docker logs are enough at this scale). To turn it on: start the
# `observability` profile (see DEPLOY.md), then set:
#   CYMBRA_OTLP_ENABLED=true
#   CYMBRA_OTLP_ENDPOINT=http://otel-collector:4317
# and fill the Grafana Cloud (free tier) creds the collector forwards to:
CYMBRA_OTLP_ENDPOINT=http://otel-collector:4317
CYMBRA_OTLP_ENABLED=false
CYMBRA_TRACE_SAMPLE_RATIO=1.0
# Grafana Cloud OTLP (only used when the observability profile is running):
#   GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
#   GRAFANA_OTLP_AUTH=<base64 of "instanceID:token">
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_AUTH=
