# Cymbra backend — PRODUCTION env (single-box). Copy to `.env` on the server and
# fill EVERY value. Never commit the filled `.env`. Keep it `chmod 600`.
#
# IMPORTANT coupling: the CYMBRA_*_DB_PASSWORD values below are what db/init sets
# as the per-module role passwords on first Postgres init; they MUST match the
# passwords embedded in the corresponding *_DATABASE_URL. Change one → change both.

# --- Public domain (Caddy TLS + the URL the apps target) ---------------------
API_DOMAIN=api.example.com

# --- Backend image (GHCR) ----------------------------------------------------
CYMBRA_IMAGE=ghcr.io/neetrof/cymbra-backend:latest

# --- Postgres superuser + per-module role passwords --------------------------
# Generate each with:  openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_superuser
CYMBRA_AUTH_DB_PASSWORD=CHANGE_ME_auth
CYMBRA_USER_DB_PASSWORD=CHANGE_ME_user
CYMBRA_WORKER_DB_PASSWORD=CHANGE_ME_worker
CYMBRA_ADMIN_DB_PASSWORD=CHANGE_ME_admin
# music_svc: only needed to enable user score upload (see the score-storage block
# below). On a box provisioned before the music module existed, create the role
# first with backend/deploy/provision-music-role.sql.
CYMBRA_MUSIC_DB_PASSWORD=CHANGE_ME_music
# analytics_svc: only needed to enable feature-usage analytics (see the block
# below). On a box provisioned before the analytics module existed, create the
# role + schema first with backend/deploy/provision-analytics-role.sql.
CYMBRA_ANALYTICS_DB_PASSWORD=CHANGE_ME_analytics

# --- Database URLs (host = the compose service name `postgres`) ---------------
# The password in each URL must equal the matching CYMBRA_*_DB_PASSWORD above.
CYMBRA_AUTH_DATABASE_URL=postgres://auth_svc:CHANGE_ME_auth@postgres:5432/cymbra
CYMBRA_USER_DATABASE_URL=postgres://user_svc:CHANGE_ME_user@postgres:5432/cymbra
CYMBRA_WORKER_DATABASE_URL=postgres://worker_svc:CHANGE_ME_worker@postgres:5432/cymbra
CYMBRA_ADMIN_DATABASE_URL=postgres://admin_svc:CHANGE_ME_admin@postgres:5432/cymbra

# --- Feature-usage analytics (OPTIONAL — leave unset to keep it off) -----------
# The UsageService (telemetry ingestion + the back-office "Usage" console) mounts
# ONLY when BOTH vars below are set; otherwise the server logs
# "analytics UsageService disabled" and runs without it. On a box provisioned
# before the analytics module existed, create the role/schema first with
# backend/deploy/provision-analytics-role.sql, then roll the server (its MIGRATOR
# creates analytics.usage_events + the two daily aggregates).
#
# analytics_svc DB (password must equal CYMBRA_ANALYTICS_DB_PASSWORD above):
CYMBRA_ANALYTICS_DATABASE_URL=postgres://analytics_svc:CHANGE_ME_analytics@postgres:5432/cymbra
# Master secret for the period-salted pseudonymous `user_bucket` (NOT a DB
# password). Generate a STABLE random value ONCE — changing it re-buckets every
# user and breaks distinct-count continuity:  openssl rand -hex 32
CYMBRA_ANALYTICS_BUCKET_SECRET=CHANGE_ME_openssl_rand_hex_32

# --- User score upload (OPTIONAL — leave the whole block unset to keep it off) -
# The ScoreService (user-contributed scores) mounts ONLY when CYMBRA_SCORE_S3_BUCKET
# is set; otherwise the server logs "score-upload disabled" and runs without it.
# To enable, set ALL of the S3 vars + the music DB URL, then roll the server (its
# MIGRATOR then creates music.catalog_scores + music.user_scores).
#
# music_svc DB (password must equal CYMBRA_MUSIC_DB_PASSWORD above):
CYMBRA_MUSIC_DATABASE_URL=postgres://music_svc:CHANGE_ME_music@postgres:5432/cymbra
# Object store = the durable S3 origin for uploads AND the score corpus fallback
# (OVH Object Storage; one bucket shared with the crawler mirror — same keyspace):
CYMBRA_SCORE_S3_BUCKET=cymbra-scores
CYMBRA_SCORE_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
CYMBRA_SCORE_S3_REGION=gra
CYMBRA_SCORE_S3_ACCESS_KEY=CHANGE_ME_s3_access_key
CYMBRA_SCORE_S3_SECRET_KEY=CHANGE_ME_s3_secret_key
# CYMBRA_SCORE_S3_ALLOW_HTTP=false          # OVH is https; keep unset in prod
# Local-first cache root — the CONTAINER path (default /srv/cymbra/scores). The
# compose bind-mounts the host SCORES_DIR there (writable); do NOT set this to the
# host path. The host dir must be owned by the container UID (1000):
#   sudo chown -R 1000:1000 "${SCORES_DIR:-/var/lib/cymbra/scores}"
# CYMBRA_SCORE_LOCAL_ROOT=/srv/cymbra/scores   # leave unset to use the default
# Rolling upload quota + size cap (defaults shown; override only to change them):
# CYMBRA_SCORE_UPLOAD_QUOTA_MAX=5
# CYMBRA_SCORE_UPLOAD_QUOTA_WINDOW_DAYS=7
# CYMBRA_SCORE_UPLOAD_MAX_BYTES=8388608

# --- SoundFont delivery (change: add-soundfont-delivery) ----------------------
# A DEDICATED, PRIVATE OVH bucket, SEPARATE from cymbra-scores (different ACL/cache;
# holds the piano SoundFonts served to authenticated clients — the back-office preview
# playback and, later, the app's piano picker + PAID fonts). Endpoint/region may reuse
# the OVH account, but prefer a dedicated access key scoped to this bucket. Unset the
# bucket to disable the /soundfonts/* route (it then responds 503).
# Seed the default font once (private object):
#   aws --endpoint-url https://s3.gra.io.cloud.ovh.net \
#     s3 cp UprightPianoKW-20220221.sf2 s3://cymbra-soundfonts/UprightPianoKW-20220221.sf2
CYMBRA_SOUNDFONT_S3_BUCKET=cymbra-soundfonts
CYMBRA_SOUNDFONT_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
CYMBRA_SOUNDFONT_S3_REGION=gra
CYMBRA_SOUNDFONT_S3_ACCESS_KEY=CHANGE_ME_soundfont_access_key
CYMBRA_SOUNDFONT_S3_SECRET_KEY=CHANGE_ME_soundfont_secret_key
# CYMBRA_SOUNDFONT_S3_ALLOW_HTTP=false        # OVH is https; keep unset in prod
# Local warm-cache root — CONTAINER path (default /srv/cymbra/soundfonts), distinct
# from the scores cache. The compose bind-mounts the host SOUNDFONTS_DIR there
# (writable); the store create_dir_all()s + warms it at boot, so the host dir MUST be
# owned by the container UID 1000 — else the server crash-loops on boot:
#   sudo chown -R 1000:1000 "${SOUNDFONTS_DIR:-/var/lib/cymbra/soundfonts}"
# Leave CYMBRA_SOUNDFONT_LOCAL_ROOT unset to use the default container path.
# CYMBRA_SOUNDFONT_LOCAL_ROOT=/srv/cymbra/soundfonts

# --- Redis / Valkey (host = the compose service name `valkey`) ----------------
CYMBRA_REDIS_URL=redis://valkey:6379

# --- gRPC + HTTP listeners (inside the container; Caddy fronts them) ----------
CYMBRA_GRPC_ADDR=0.0.0.0:50051
CYMBRA_HTTP_ADDR=0.0.0.0:8081

# --- App audiences -----------------------------------------------------------
# `back-office` is the admin console audience (scope-aware-role-admin): its token
# carries the admin's roles across global/music/live for scope-matched role admin.
# It MUST be present before the back office deploys, or its sign-in is rejected.
CYMBRA_ALLOWED_AUDIENCES=music,live,back-office

# --- Back office (bo.cymbra.app) — browser console CORS + refresh cookie -------
# The Vue moderation console runs cross-origin from the API. Leave these unset and
# the console cannot reach the backend at all:
#   * CYMBRA_BACK_OFFICE_ORIGINS — exact-origin allow-list shared by the gRPC-web
#     CorsLayer AND the web-auth cookie CORS (credentialed, never `*`). Empty (the
#     default) = no cross-origin browser access. CSV for multiple origins.
#   * CYMBRA_WEB_AUTH_COOKIE_DOMAIN — the registrable domain shared by API_DOMAIN and
#     the SPA host, so the HttpOnly refresh cookie is first-party for the console. A
#     HARD requirement: host-only on api.* is never sent by bo.* (see the back-office
#     README "same-site" constraint). Must be a parent of both hosts.
#   * CYMBRA_WEB_AUTH_COOKIE_SECURE — HTTPS-only cookie; defaults true. Keep it true
#     in prod (set false only for plain-HTTP localhost dev).
CYMBRA_BACK_OFFICE_ORIGINS=https://bo.cymbra.app
CYMBRA_WEB_AUTH_COOKIE_DOMAIN=cymbra.app
# CYMBRA_WEB_AUTH_COOKIE_SECURE=true

# --- Internal token signing (EdDSA Ed25519; public key served at JWKS) --------
# Generate once:
#   openssl genpkey -algorithm ed25519 -out priv.pem
#   openssl pkey -in priv.pem -pubout -out pub.pem
# Paste the PEM bodies here (multi-line PEM must be quoted or \n-escaped — see DEPLOY.md).
CYMBRA_TOKEN_SIGNING_KEY_PEM=
CYMBRA_TOKEN_PUBLIC_KEY_PEM=
CYMBRA_TOKEN_SIGNING_KID=k1
CYMBRA_ACCESS_TOKEN_TTL=15m
CYMBRA_REFRESH_TOKEN_TTL=30d

# --- OIDC providers (Google / Apple) -----------------------------------------
CYMBRA_GOOGLE_ISSUER=https://accounts.google.com
CYMBRA_GOOGLE_AUDIENCE=
CYMBRA_APPLE_ISSUER=https://appleid.apple.com
CYMBRA_APPLE_AUDIENCE=
# Below are UNUSED by the current native-id_token flow (the backend only verifies
# Apple's id_token against its JWKS). Fill them only if/when you add the web
# authorization-code exchange or Apple server-to-server token revocation.
CYMBRA_APPLE_P8_KEY_PEM=
CYMBRA_APPLE_TEAM_ID=
CYMBRA_APPLE_KEY_ID=

# --- Local credential hardening ----------------------------------------------
CYMBRA_PASSWORD_MIN_LENGTH=12
CYMBRA_SIGNIN_MAX_ATTEMPTS=5
CYMBRA_SIGNIN_LOCKOUT=15m
CYMBRA_EMAIL_SEND_RATE=3/1h

# --- SMTP (verification / reset email) — real transactional provider ----------
# Recommended: Brevo (EU-hosted, GDPR-friendly, free tier ~300 emails/day; SMTP
# relay works directly with lettre's STARTTLS on 587). Alternatives: Resend (EU
# region, free 3k/mo), Postmark (best deliverability, paid).
# Brevo example (login = your Brevo account email, pass = an SMTP *key*, not your
# password): smtp://you@example.com:xkeysib-...@smtp-relay.brevo.com:587
CYMBRA_SMTP_URL=smtp://SMTP_LOGIN:SMTP_KEY@smtp-relay.brevo.com:587
# FROM must be on a domain you control AND have SPF+DKIM+DMARC set up for (see
# DEPLOY.md §Email deliverability), or the branded HTML mail lands in spam / reads
# as phishing. Display-name form is branded as the shared "Cymbra ID" identity.
CYMBRA_SMTP_FROM=Cymbra ID <no-reply@cymbra.app>
# Hosted neutral "Cymbra ID" logo (on cymbra.app); unset = text wordmark only.
CYMBRA_EMAIL_LOGO_URL=https://cymbra.app/brand/cymbra-id.png

# --- Background worker --------------------------------------------------------
# Also reads CYMBRA_AUTH_DATABASE_URL above (the session-reaper deletes expired
# auth.sessions) and CYMBRA_USER_DATABASE_URL (the orphan-reaper).
CYMBRA_WORKER_HTTP_ADDR=0.0.0.0:8082
CYMBRA_WORKER_CONCURRENCY_MIN=1
CYMBRA_WORKER_CONCURRENCY_MAX=16
CYMBRA_WORKER_SCHEDULER_INTERVAL=30s
CYMBRA_WORKER_DLQ_SWEEP_INTERVAL=60s
CYMBRA_ORPHAN_REAP_GRACE=24h

# --- Push notifications (worker only; change: add-push-notifications) ---------
# Firebase service-account key JSON for the FCM HTTP v1 sender. One Firebase
# project reaches iOS + Android + macOS (Apple platforms via FCM->APNs), so this
# is the single sending credential.
#
# SECRET: this key can send a notification to any of your users. It belongs here
# in .env (gitignored, chmod 600 on the box), never in the repo. Rotate it in the
# Cloud console (IAM -> Service accounts -> Keys) if it ever leaks; the worker
# then runs with `push_dispatch` inert until a new one is set.
#
# Paste the whole key file on ONE line, WRAPPED IN SINGLE QUOTES, keeping the \n
# escapes inside private_key exactly as the JSON has them. The quotes are not
# cosmetic: without them the dotenv parser reads the JSON's own double quotes as
# quoting and strips them, and the worker refuses to start with "invalid FCM
# service-account JSON: key must be a string at line 1 column 2".
#
# Unset (the default) leaves push disabled: clients still register tokens and
# store preferences, nothing is ever sent.
#
# Sending is ALSO gated by the `notifications.enabled` feature flag (default OFF)
# and by each category's own flag - see backend/notifications/README.md.
# CYMBRA_FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"cymbra-e4943","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@cymbra-e4943.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}'

# --- OpenTelemetry -----------------------------------------------------------
# OFF by default (docker logs are enough at this scale). To turn it on: start the
# `observability` profile (see DEPLOY.md), then set:
#   CYMBRA_OTLP_ENABLED=true
#   CYMBRA_OTLP_ENDPOINT=http://otel-collector:4317
# and fill the Grafana Cloud (free tier) creds the collector forwards to:
CYMBRA_OTLP_ENDPOINT=http://otel-collector:4317
CYMBRA_OTLP_ENABLED=false
CYMBRA_TRACE_SAMPLE_RATIO=1.0
# Grafana Cloud OTLP (only used when the observability profile is running):
#   GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
#   GRAFANA_OTLP_AUTH=<base64 of "instanceID:token">
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_AUTH=
