# Cymbra ID — backend configuration (task 1.7).
# Copy to `.env` for local dev. Values here match backend/docker-compose.yml.
# Loaded by the typed config layer (task 2.1); missing required keys fail fast.

# --- gRPC + HTTP listeners ---------------------------------------------------
CYMBRA_GRPC_ADDR=0.0.0.0:50051
CYMBRA_HTTP_ADDR=0.0.0.0:8081          # Axum surface: /.well-known/jwks.json, /healthz

# --- Postgres (one role per module; confined to its own schema) --------------
CYMBRA_AUTH_DATABASE_URL=postgres://auth_svc:auth_dev_pw@localhost:5432/cymbra
CYMBRA_USER_DATABASE_URL=postgres://user_svc:user_dev_pw@localhost:5432/cymbra
# music_svc owns the `music` schema (score catalog + user uploads). Required to
# wire the score-upload service; omit to leave that feature unwired.
CYMBRA_MUSIC_DATABASE_URL=postgres://music_svc:music_dev_pw@localhost:5432/cymbra
# worker_svc owns the shared `jobs` schema (queue + scheduler + dead-letter).
CYMBRA_WORKER_DATABASE_URL=postgres://worker_svc:worker_dev_pw@localhost:5432/cymbra
# flags_svc owns the shared `feature_flags` schema (runtime flag/config store +
# change audit). Omit to run the flag service in defaults-only mode (every key
# resolves to its code default; admin edits refused) — a valid fail-safe posture.
CYMBRA_FLAGS_DATABASE_URL=postgres://flags_svc:flags_dev_pw@localhost:5432/cymbra
# analytics_svc owns the dedicated `analytics` schema (first-party feature-usage
# telemetry; change: add-feature-usage-analytics). Omit to leave the UsageService
# unwired (ingestion + reporting stay inert until configured).
CYMBRA_ANALYTICS_DATABASE_URL=postgres://analytics_svc:analytics_dev_pw@localhost:5432/cymbra
# Master secret for the period-salted pseudonymous analytics `user_bucket`
# (salt(month) = HMAC(secret, "YYYY-MM")). Required alongside the URL above to wire
# the UsageService; a missing secret leaves it unwired (never a guessable key).
# Generate a stable random value, e.g. `openssl rand -hex 32`, and keep it secret.
CYMBRA_ANALYTICS_BUCKET_SECRET=analytics_dev_bucket_secret_change_me
# plans_svc owns the dedicated `plans` schema (free/premium entitlement ledger,
# beta campaigns + memberships, access codes, billing-event idempotency; change:
# add-premium-subscription). Identifiers only — never billing PII. Omit to leave
# PlanService unwired (every plan-aware seam answers `free`).
CYMBRA_PLANS_DATABASE_URL=postgres://plans_svc:plans_dev_pw@localhost:5432/cymbra
# --- purchase channels (change: add-premium-subscription) ----------------------
# Each block is optional: absent = the channel is not wired (its notification
# route is not mounted, its paywall button never shown). The runtime flags
# `billing.{apple,google,web}.enabled` gate a WIRED channel without a redeploy.
# Nothing here is a card, an address or an invoice — the stores and the web
# merchant-of-record own those; Cymbra keeps identifiers only.
#
# Apple (StoreKit 2 signed transactions + App Store Server Notifications v2).
# The bundle id every payload must carry; ALLOW_SANDBOX accepts TestFlight /
# sandbox payloads (staging only). The App Store Connect API key (PEM with \n
# escapes) + key/issuer ids power the reconciliation reads (Server API).
# CYMBRA_APPLE_BUNDLE_ID=com.cymbra.music
# CYMBRA_APPLE_ALLOW_SANDBOX=false
# CYMBRA_APPLE_ASC_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# CYMBRA_APPLE_ASC_KEY_ID=ABC123DEFG
# CYMBRA_APPLE_ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
#
# Google (Play Billing + Play Developer API + Real-Time Developer Notifications).
# A service account with the "androidpublisher" scope reads/acknowledges
# subscriptions; RTDN arrives as a Pub/Sub push authenticated by a Google OIDC
# token whose `aud` is the endpoint URL and whose `email` is the push account.
# CYMBRA_GOOGLE_PACKAGE_NAME=com.cymbra.music
# CYMBRA_GOOGLE_SA_EMAIL=play-billing@project.iam.gserviceaccount.com
# CYMBRA_GOOGLE_SA_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# CYMBRA_GOOGLE_RTDN_AUDIENCE=https://api.cymbra.app/billing/google/rtdn
# CYMBRA_GOOGLE_RTDN_SA_EMAIL=pubsub-push@project.iam.gserviceaccount.com
#
# Web merchant-of-record (Paddle Billing): API key, webhook endpoint secret,
# the hosted checkout page (receives `_ptxn=<transaction id>`), and an optional
# return URL. SANDBOX selects the sandbox API host.
# CYMBRA_PADDLE_API_KEY=pdl_live_...
# CYMBRA_PADDLE_SANDBOX=false
# CYMBRA_PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
# The site page hosting Paddle.js (change: add-site-account-pages); it receives
# `_ptxn=<transaction id>` and returns to `/checkout/done` (a page setting).
# CYMBRA_PADDLE_CHECKOUT_PAGE=https://cymbra.app/checkout

# admin_svc reads/writes EVERY schema from one connection (crosses D0) — for
# ops/runners/psql AND the cymbra-worker `purge_user` job (complete account
# deletion: erase user_account + auth atomically). NEVER read by an app service.
CYMBRA_ADMIN_DATABASE_URL=postgres://admin_svc:admin_dev_pw@localhost:5432/cymbra

# --- DB role bootstrap (db/init/00-roles.sh) ---------------------------------
# Role passwords for the bootstrap, defaulting to the dev values above. In prod,
# inject these from a secret store (or use IAM auth and ignore them) — never
# commit prod secrets. See backend/README.md.
# CYMBRA_AUTH_DB_PASSWORD=auth_dev_pw
# CYMBRA_USER_DB_PASSWORD=user_dev_pw
# CYMBRA_WORKER_DB_PASSWORD=worker_dev_pw
# CYMBRA_FLAGS_DB_PASSWORD=flags_dev_pw
# CYMBRA_ANALYTICS_DB_PASSWORD=analytics_dev_pw
# CYMBRA_PLANS_DB_PASSWORD=plans_dev_pw
# CYMBRA_ADMIN_DB_PASSWORD=admin_dev_pw

# --- Redis (sessions/refresh, rate-limit counters, email throttles) ----------
CYMBRA_REDIS_URL=redis://localhost:6379

# --- App audiences (one login per app; allow-list) ---------------------------
# `back-office` is the admin console audience: its token carries the admin's real
# roles across global/music/live so role administration can be scope-matched.
# `web` is the public site's audience (cymbra.app/redeem, /account — change:
# add-site-account-pages): a plain-user audience with no console power; it is what
# lets a session redeem a beta code (the store-build `music` audience cannot).
CYMBRA_ALLOWED_AUDIENCES=music,live,back-office,web

# --- Browser origins (site + back office) ------------------------------------
# CYMBRA_BACK_OFFICE_ORIGINS — gRPC-web CORS allow-list (console only).
# CYMBRA_WEB_ORIGINS — allow-list for the web-auth cookie surface AND the site's
# plan JSON routes (/web/plans/*): the public site plus the back office. Unset ⇒
# same as CYMBRA_BACK_OFFICE_ORIGINS. Exact origins, CSV.
# CYMBRA_BACK_OFFICE_ORIGINS=https://bo.cymbra.app
# CYMBRA_WEB_ORIGINS=https://cymbra.app,https://bo.cymbra.app

# --- Internal token signing (asymmetric; public keys served at JWKS) ---------
# EdDSA (Ed25519) keypair in PEM; the public key is served at the JWKS endpoint,
# `kid` identifies it. Generate: openssl genpkey -algorithm ed25519 -out priv.pem
#                                openssl pkey -in priv.pem -pubout -out pub.pem
CYMBRA_TOKEN_SIGNING_KEY_PEM=
CYMBRA_TOKEN_PUBLIC_KEY_PEM=
CYMBRA_TOKEN_SIGNING_KID=k1
CYMBRA_ACCESS_TOKEN_TTL=15m
CYMBRA_REFRESH_TOKEN_TTL=30d

# --- OIDC providers ----------------------------------------------------------
CYMBRA_GOOGLE_ISSUER=https://accounts.google.com
# Accepted Google client id(s) — comma-separated for multiple. Web/Android/iOS
# use the web client; the Windows/Linux desktop-loopback flow uses its own
# "Desktop app" client, so add it too, e.g.:
#   CYMBRA_GOOGLE_AUDIENCE=<web-client>.apps.googleusercontent.com,<desktop-client>.apps.googleusercontent.com
CYMBRA_GOOGLE_AUDIENCE=
CYMBRA_APPLE_ISSUER=https://appleid.apple.com
# Native iOS/macOS Sign in with Apple: aud = the app bundle ID (e.g. com.cymbra.music).
CYMBRA_APPLE_AUDIENCE=
# Apple client secret is a JWT signed with this .p8 key (<=6mo, regenerated).
CYMBRA_APPLE_P8_KEY_PEM=
CYMBRA_APPLE_TEAM_ID=
CYMBRA_APPLE_KEY_ID=
# Local dev OIDC issuer (mock-oauth2-server):
CYMBRA_DEV_OIDC_ISSUER=http://localhost:8080/default

# --- Local credential hardening ----------------------------------------------
CYMBRA_PASSWORD_MIN_LENGTH=12
CYMBRA_SIGNIN_MAX_ATTEMPTS=5
CYMBRA_SIGNIN_LOCKOUT=15m
CYMBRA_EMAIL_SEND_RATE=3/1h           # max verification/reset emails per window

# --- SMTP (verification / reset email) ---------------------------------------
CYMBRA_SMTP_URL=smtp://localhost:1025
# `From` accepts a display-name form (branded as the shared "Cymbra ID" identity).
CYMBRA_SMTP_FROM=Cymbra ID <no-reply@cymbra.dev>
# Hosted neutral "Cymbra ID" logo shown in branded email headers; unset = text
# wordmark only (the wordmark stays under the logo either way, since many clients
# block images by default).
CYMBRA_EMAIL_LOGO_URL=https://cymbra.app/brand/cymbra-id.png

# --- Background worker (cymbra-worker; change: add-job-infrastructure) --------
# Required for any background work to run. Reads CYMBRA_WORKER_DATABASE_URL (the
# queue), CYMBRA_USER_DATABASE_URL (the orphan-reaper writes), CYMBRA_AUTH_DATABASE_URL
# (the session-reaper deletes expired auth.sessions; change: durable-sessions-postgres),
# and the SMTP vars above (the email job). Pickup is event-driven (LISTEN/NOTIFY); the
# operational tunable is concurrency, not a poll interval (design D7).
CYMBRA_WORKER_HTTP_ADDR=0.0.0.0:8082    # /healthz, /readyz
CYMBRA_WORKER_CONCURRENCY_MIN=1
CYMBRA_WORKER_CONCURRENCY_MAX=16
CYMBRA_WORKER_SCHEDULER_INTERVAL=30s    # how often jobs.schedules is evaluated
CYMBRA_WORKER_DLQ_SWEEP_INTERVAL=60s    # how often exhausted jobs are dead-lettered
# Grace before a handle-less account (abandoned onboarding) is reaped. The reaper
# is now a scheduled job (jobs.schedules row 'orphan_reap_hourly') run by the
# worker — its *cadence* is that row's cron; this only sets the grace window.
CYMBRA_ORPHAN_REAP_GRACE=24h

# --- Push notifications (change: add-push-notifications) ---------------------
# Firebase service-account key JSON for the FCM HTTP v1 sender (worker only). One
# Firebase project reaches iOS + Android + macOS: Android natively, Apple via the
# APNs auth key uploaded to Firebase.
#
# Paste the whole key file on ONE line, WRAPPED IN SINGLE QUOTES. Without them the
# dotenv parser treats the JSON's own double quotes as quoting and strips them, so
# the worker receives {type:service_account,...} and refuses to start with
# "invalid FCM service-account JSON: key must be a string at line 1 column 2".
# Single quotes take the value literally, including the \n escapes in private_key.
# Unset ⇒ the `push_dispatch` job completes as a no-op — clients can still
# register tokens and set preferences, nothing is ever sent.
# CYMBRA_FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'
# Sending is ALSO gated by the `notifications.enabled` feature flag (default off)
# and per-category flags — see backend/notifications/README.md.

# --- OpenTelemetry -----------------------------------------------------------
# Honored by BOTH cymbra-server (service `cymbra-server`) and cymbra-worker (service
# `cymbra-worker`) — each exports its own traces/metrics/logs over OTLP.
CYMBRA_OTLP_ENDPOINT=http://localhost:4317
CYMBRA_OTLP_ENABLED=false             # disabled by default for offline/test runs
CYMBRA_TRACE_SAMPLE_RATIO=1.0

# --- User-uploaded scores: object store + quota (change: add-user-score-upload) --
# S3-compatible store for user uploads. Leave CYMBRA_SCORE_S3_BUCKET unset to keep
# the score-upload feature OFF; setting the bucket makes the other S3_* keys
# REQUIRED (a partial config fails fast at boot). Dev defaults match the `minio`
# service in docker-compose.yml (bucket created by `minio-init`).
CYMBRA_SCORE_S3_BUCKET=cymbra-scores
CYMBRA_SCORE_S3_ENDPOINT=http://localhost:9000
CYMBRA_SCORE_S3_REGION=us-east-1
CYMBRA_SCORE_S3_ACCESS_KEY=cymbra_dev
CYMBRA_SCORE_S3_SECRET_KEY=cymbra_dev_pw
CYMBRA_SCORE_S3_ALLOW_HTTP=true       # dev MinIO over http; keep false/unset in prod
# Local warm-cache root reads serve from (crawler corpus + pulled uploads). The S3
# fallback populates it on a miss; safe to wipe/rebuild.
CYMBRA_SCORE_LOCAL_ROOT=/srv/cymbra/scores
# Per-user rolling upload quota + hard per-file size cap (server-enforced).
CYMBRA_SCORE_UPLOAD_QUOTA_MAX=5
CYMBRA_SCORE_UPLOAD_QUOTA_WINDOW_DAYS=7
CYMBRA_SCORE_UPLOAD_MAX_BYTES=8388608   # 8 MiB

# --- Per-user catalog access limits (anti-scraping guardrail) ---------------
# Stops one token from siphoning the whole catalog. A `music`-scope admin (and the
# `global` break-glass) is exempt; moderators and other-scope admins are not.
# Kill-switch: set false to disable enforcement entirely.
CYMBRA_CATALOG_LIMIT_ENABLED=true
# Download BURST: pure rate cap on raw-score-bytes fetches (per user).
CYMBRA_CATALOG_DL_BURST_MAX=20
CYMBRA_CATALOG_DL_BURST_WINDOW=1m
# Download VOLUME: engagement-aware allowance over the window =
#   min(HARD_CEILING, BASE_FLOOR + PER_ENGAGEMENT * engagement_in_window),
# where engagement = play sessions + score ratings (the swipe deck). Both playing
# and rating are genuine engagement that earns download headroom, so a user whose
# downloads track their activity is never blocked; a download-heavy/engagement-light
# (bot) profile falls back to BASE_FLOOR.
CYMBRA_CATALOG_DL_VOLUME_WINDOW=24h
CYMBRA_CATALOG_DL_BASE_FLOOR=30
CYMBRA_CATALOG_DL_PER_ENGAGEMENT=3
CYMBRA_CATALOG_DL_HARD_CEILING=500
# ENUMERATION: request-rate cap on catalog browse/search/rating-deck (per user).
CYMBRA_CATALOG_ENUM_MAX=60
CYMBRA_CATALOG_ENUM_WINDOW=1m
# These values are the DEPLOYMENT BASELINE. Every one of them is also a runtime
# feature-flag key (`catalog.access_limits.*`, app `music`), read on each checked
# request: an override set in the back office wins over the value here and applies
# to the next request — no redeploy — and clearing it falls back to this baseline.
# Windows are seconds in the flag (`*_window_s`), a duration string here. Flip
# `catalog.access_limits.enabled` off to disable the guardrail without a deploy.
