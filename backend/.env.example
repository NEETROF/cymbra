# Cymbra ID — backend configuration (task 1.7).
# Copy to `.env` for local dev. Values here match backend/docker-compose.yml.
# Loaded by the typed config layer (task 2.1); missing required keys fail fast.

# --- gRPC + HTTP listeners ---------------------------------------------------
CYMBRA_GRPC_ADDR=0.0.0.0:50051
CYMBRA_HTTP_ADDR=0.0.0.0:8081          # Axum surface: /.well-known/jwks.json, /healthz

# --- Postgres (one role per module; confined to its own schema) --------------
CYMBRA_AUTH_DATABASE_URL=postgres://auth_svc:auth_dev_pw@localhost:5432/cymbra
CYMBRA_USER_DATABASE_URL=postgres://user_svc:user_dev_pw@localhost:5432/cymbra
# music_svc owns the `music` schema (score catalog + user uploads). Required to
# wire the score-upload service; omit to leave that feature unwired.
CYMBRA_MUSIC_DATABASE_URL=postgres://music_svc:music_dev_pw@localhost:5432/cymbra
# worker_svc owns the shared `jobs` schema (queue + scheduler + dead-letter).
CYMBRA_WORKER_DATABASE_URL=postgres://worker_svc:worker_dev_pw@localhost:5432/cymbra
# flags_svc owns the shared `feature_flags` schema (runtime flag/config store +
# change audit). Omit to run the flag service in defaults-only mode (every key
# resolves to its code default; admin edits refused) — a valid fail-safe posture.
CYMBRA_FLAGS_DATABASE_URL=postgres://flags_svc:flags_dev_pw@localhost:5432/cymbra
# admin_svc reads/writes EVERY schema from one connection (crosses D0) — for
# ops/runners/psql AND the cymbra-worker `purge_user` job (complete account
# deletion: erase user_account + auth atomically). NEVER read by an app service.
CYMBRA_ADMIN_DATABASE_URL=postgres://admin_svc:admin_dev_pw@localhost:5432/cymbra

# --- DB role bootstrap (db/init/00-roles.sh) ---------------------------------
# Role passwords for the bootstrap, defaulting to the dev values above. In prod,
# inject these from a secret store (or use IAM auth and ignore them) — never
# commit prod secrets. See backend/README.md.
# CYMBRA_AUTH_DB_PASSWORD=auth_dev_pw
# CYMBRA_USER_DB_PASSWORD=user_dev_pw
# CYMBRA_WORKER_DB_PASSWORD=worker_dev_pw
# CYMBRA_FLAGS_DB_PASSWORD=flags_dev_pw
# CYMBRA_ADMIN_DB_PASSWORD=admin_dev_pw

# --- Redis (sessions/refresh, rate-limit counters, email throttles) ----------
CYMBRA_REDIS_URL=redis://localhost:6379

# --- App audiences (one login per app; allow-list) ---------------------------
# `back-office` is the admin console audience: its token carries the admin's real
# roles across global/music/live so role administration can be scope-matched.
CYMBRA_ALLOWED_AUDIENCES=music,live,back-office

# --- Internal token signing (asymmetric; public keys served at JWKS) ---------
# EdDSA (Ed25519) keypair in PEM; the public key is served at the JWKS endpoint,
# `kid` identifies it. Generate: openssl genpkey -algorithm ed25519 -out priv.pem
#                                openssl pkey -in priv.pem -pubout -out pub.pem
CYMBRA_TOKEN_SIGNING_KEY_PEM=
CYMBRA_TOKEN_PUBLIC_KEY_PEM=
CYMBRA_TOKEN_SIGNING_KID=k1
CYMBRA_ACCESS_TOKEN_TTL=15m
CYMBRA_REFRESH_TOKEN_TTL=30d

# --- OIDC providers ----------------------------------------------------------
CYMBRA_GOOGLE_ISSUER=https://accounts.google.com
# Accepted Google client id(s) — comma-separated for multiple. Web/Android/iOS
# use the web client; the Windows/Linux desktop-loopback flow uses its own
# "Desktop app" client, so add it too, e.g.:
#   CYMBRA_GOOGLE_AUDIENCE=<web-client>.apps.googleusercontent.com,<desktop-client>.apps.googleusercontent.com
CYMBRA_GOOGLE_AUDIENCE=
CYMBRA_APPLE_ISSUER=https://appleid.apple.com
# Native iOS/macOS Sign in with Apple: aud = the app bundle ID (e.g. com.cymbra.music).
CYMBRA_APPLE_AUDIENCE=
# Apple client secret is a JWT signed with this .p8 key (<=6mo, regenerated).
CYMBRA_APPLE_P8_KEY_PEM=
CYMBRA_APPLE_TEAM_ID=
CYMBRA_APPLE_KEY_ID=
# Local dev OIDC issuer (mock-oauth2-server):
CYMBRA_DEV_OIDC_ISSUER=http://localhost:8080/default

# --- Local credential hardening ----------------------------------------------
CYMBRA_PASSWORD_MIN_LENGTH=12
CYMBRA_SIGNIN_MAX_ATTEMPTS=5
CYMBRA_SIGNIN_LOCKOUT=15m
CYMBRA_EMAIL_SEND_RATE=3/1h           # max verification/reset emails per window

# --- SMTP (verification / reset email) ---------------------------------------
CYMBRA_SMTP_URL=smtp://localhost:1025
# `From` accepts a display-name form (branded as the shared "Cymbra ID" identity).
CYMBRA_SMTP_FROM=Cymbra ID <no-reply@cymbra.dev>
# Optional hosted "Cymbra ID" logo shown in branded email headers; unset = text
# wordmark only (until the neutral logo asset is hosted on cymbra.app).
# CYMBRA_EMAIL_LOGO_URL=https://cymbra.app/brand/cymbra-id.png

# --- Background worker (cymbra-worker; change: add-job-infrastructure) --------
# Required for any background work to run. Reads CYMBRA_WORKER_DATABASE_URL (the
# queue), CYMBRA_USER_DATABASE_URL (the orphan-reaper writes), CYMBRA_AUTH_DATABASE_URL
# (the session-reaper deletes expired auth.sessions; change: durable-sessions-postgres),
# and the SMTP vars above (the email job). Pickup is event-driven (LISTEN/NOTIFY); the
# operational tunable is concurrency, not a poll interval (design D7).
CYMBRA_WORKER_HTTP_ADDR=0.0.0.0:8082    # /healthz, /readyz
CYMBRA_WORKER_CONCURRENCY_MIN=1
CYMBRA_WORKER_CONCURRENCY_MAX=16
CYMBRA_WORKER_SCHEDULER_INTERVAL=30s    # how often jobs.schedules is evaluated
CYMBRA_WORKER_DLQ_SWEEP_INTERVAL=60s    # how often exhausted jobs are dead-lettered
# Grace before a handle-less account (abandoned onboarding) is reaped. The reaper
# is now a scheduled job (jobs.schedules row 'orphan_reap_hourly') run by the
# worker — its *cadence* is that row's cron; this only sets the grace window.
CYMBRA_ORPHAN_REAP_GRACE=24h

# --- OpenTelemetry -----------------------------------------------------------
# Honored by BOTH cymbra-server (service `cymbra-server`) and cymbra-worker (service
# `cymbra-worker`) — each exports its own traces/metrics/logs over OTLP.
CYMBRA_OTLP_ENDPOINT=http://localhost:4317
CYMBRA_OTLP_ENABLED=false             # disabled by default for offline/test runs
CYMBRA_TRACE_SAMPLE_RATIO=1.0

# --- User-uploaded scores: object store + quota (change: add-user-score-upload) --
# S3-compatible store for user uploads. Leave CYMBRA_SCORE_S3_BUCKET unset to keep
# the score-upload feature OFF; setting the bucket makes the other S3_* keys
# REQUIRED (a partial config fails fast at boot). Dev defaults match the `minio`
# service in docker-compose.yml (bucket created by `minio-init`).
CYMBRA_SCORE_S3_BUCKET=cymbra-scores
CYMBRA_SCORE_S3_ENDPOINT=http://localhost:9000
CYMBRA_SCORE_S3_REGION=us-east-1
CYMBRA_SCORE_S3_ACCESS_KEY=cymbra_dev
CYMBRA_SCORE_S3_SECRET_KEY=cymbra_dev_pw
CYMBRA_SCORE_S3_ALLOW_HTTP=true       # dev MinIO over http; keep false/unset in prod
# Local warm-cache root reads serve from (crawler corpus + pulled uploads). The S3
# fallback populates it on a miss; safe to wipe/rebuild.
CYMBRA_SCORE_LOCAL_ROOT=/srv/cymbra/scores
# Per-user rolling upload quota + hard per-file size cap (server-enforced).
CYMBRA_SCORE_UPLOAD_QUOTA_MAX=5
CYMBRA_SCORE_UPLOAD_QUOTA_WINDOW_DAYS=7
CYMBRA_SCORE_UPLOAD_MAX_BYTES=8388608   # 8 MiB
