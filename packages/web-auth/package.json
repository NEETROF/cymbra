{
  "name": "@cymbra/web-auth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cymbra browser sign-in: Google / Apple composables + the web-auth (cookie) client. Source-only TypeScript, consumed by apps/back-office and apps/site.",
  "packageManager": "yarn@4.10.3",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.6",
    "vue": "^3.5.13"
  }
}
